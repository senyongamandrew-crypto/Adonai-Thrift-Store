#
# Copy to ".env" for local work and set the same values on your hosting
# platform for production. Never commit the real ".env" file.
#
TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

APP_NAME="Adonai Thrift Store"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_KEY=generate-a-long-random-adonis-app-key

# Public URL of the storefront, used for canonical links, sitemap.xml and
# Open Graph/Twitter preview images. Optional: when it is empty (or still
# points at localhost) the address is taken from each request, so a deployed
# site produces correct links on any domain without configuration.
APP_URL=
SITE_URL=

SESSION_DRIVER=cookie

# Redirect plain HTTP to HTTPS in production. Leave as true behind a proxy that
# forwards x-forwarded-proto; set false for local previews.
FORCE_HTTPS=true

# Drop the X-Frame-Options: DENY header so the app can be embedded in an
# iframe. Preview/sandbox environments only — keep it out of production.
# ALLOW_FRAME_EMBEDDING=true

# Private boundary to the Flask / POS backend. Server side only — never expose
# this URL or the token to the browser. Optional: without it the storefront
# still runs and tells visitors the catalog is not connected yet.
FLASK_API_BASE_URL=
FLASK_INTERNAL_API_TOKEN=

DB_CONNECTION=sqlite
DATABASE_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
ADONAI_MEDIA_DIR=./storage/media
ADONAI_MEDIA_MAX_FILE_BYTES=26214400
ADONAI_MEDIA_QUOTA_BYTES=0

ANALYTICS_PROVIDER=none
ANALYTICS_DOMAIN=
GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Storefront wording — change these from the Render dashboard, no code needed
# ---------------------------------------------------------------------------
#
# Leave any of them blank to keep the built-in value. Blank never renders an
# empty phone number or an empty headline, and PROMO_BANNER stays hidden until
# you give it a value.
#
# The phone numbers may be written in any of these shapes:
#   +256765652403    +256 765 652 403    256765652403    0765 652 403
# and the tap-to-call / WhatsApp links are rebuilt from them automatically.
#
# WHATSAPP_NUMBER=
# CALL_NUMBER=
# BANNER_TEXT=
# DELIVERY_NOTE=
# HERO_HEADLINE=
# PROMO_BANNER=Free delivery in Kampala this week
