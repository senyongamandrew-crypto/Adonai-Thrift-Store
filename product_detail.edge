<section class="adonai-shell py-8 sm:py-12" data-product-detail="{{ product.id }}">
  <a href="/#collection" class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-adonai-muted transition-colors hover:text-adonai-primary">
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" /></svg>
    Back to available pieces
  </a>
  <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
    <div class="relative" data-carousel data-carousel-index="0">
      <div class="relative aspect-[4/5] overflow-hidden rounded-lg border border-adonai-line bg-adonai-skeleton">
        @each(image in product.gallery)
          <picture class="block h-full w-full {{ image.index === 0 ? '' : 'hidden' }}" data-carousel-slide>
            @if(image.avif)
              <source srcset="{{ image.avif }}" type="image/avif" />
            @endif
            @if(image.webp)
              <source srcset="{{ image.webp }}" type="image/webp" />
            @endif
            <img src="{{ image.src }}" alt="{{ image.alt || product.name || 'Adonai Thrift Store product image' }}" class="h-full w-full object-cover" loading="{{ image.index === 0 ? 'eager' : 'lazy' }}" decoding="async" aria-hidden="{{ image.index === 0 ? 'false' : 'true' }}" />
          </picture>
        @endeach
        @if(!product.gallery || !product.gallery.length)
          <div class="adonai-photo-skeleton" role="img" aria-label="Product image not available">
            <span class="h-3 w-2/5 rounded-sm bg-adonai-skeletonDark"></span>
            <span class="h-3 w-3/5 rounded-sm bg-adonai-skeletonDark"></span>
            <span class="h-3 w-1/3 rounded-sm bg-adonai-skeletonDark"></span>
          </div>
        @endif
        @if(product.gallery && product.gallery.length > 1)
          <button type="button" data-carousel-direction="-1" class="absolute left-4 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-md border border-adonai-line bg-white text-adonai-ink shadow-sm" aria-label="Previous product image">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14 6-6 6 6 6" /></svg>
          </button>
          <button type="button" data-carousel-direction="1" class="absolute right-4 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-md border border-adonai-line bg-white text-adonai-ink shadow-sm" aria-label="Next product image">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m10 6 6 6-6 6" /></svg>
          </button>
        @endif
      </div>
      @if(product.gallery && product.gallery.length > 1)
        <div class="mt-4 flex justify-center gap-2">
          @each(image in product.gallery)
            <button type="button" data-carousel-dot="{{ image.index }}" class="h-2 w-6 rounded-sm border border-adonai-line {{ image.index === 0 ? 'bg-adonai-primary' : 'bg-adonai-line' }}" aria-label="View image {{ image.index + 1 }}"></button>
          @endeach
        </div>
      @endif
    </div>

    <div class="flex flex-col">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[.18em] text-adonai-primary">{{ product.category }}@if(product.condition) <span class="text-adonai-muted">|</span> {{ product.condition }}@endif</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-adonai-ink sm:text-5xl">{{ product.name }}</h1>
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <span class="text-xl font-extrabold text-adonai-ink">{{ product.priceFormatted }}</span>
        @if(product.originalPriceFormatted)
          <span class="text-sm text-adonai-muted line-through">{{ product.originalPriceFormatted }}</span>
        @endif
      </div>
      @if(product.description)
        <p class="mt-6 text-sm leading-7 text-adonai-muted">{{ product.description }}</p>
      @endif

      <div class="mt-8 border-t border-adonai-line pt-6">
        <div class="flex items-center justify-between gap-4"><h2 class="text-sm font-extrabold">Size</h2><span class="text-xs text-adonai-muted">{{ product.measurementNote || 'Measurements supplied by the inventory team' }}</span></div>
        <div class="mt-3 flex flex-wrap gap-2">
          @each(size in product.sizes)
            <button type="button" data-option-group="size" data-option-value="{{ size }}" class="rounded-lg border px-4 py-2.5 text-xs font-bold {{ size === product.selectedSize ? 'border-adonai-primary bg-adonai-lavender text-adonai-primary' : 'border-adonai-line bg-white text-adonai-muted' }}" aria-pressed="{{ size === product.selectedSize ? 'true' : 'false' }}">{{ size }}</button>
          @endeach
        </div>
      </div>
      @if(product.colours)
        <div class="mt-6">
          <h2 class="text-sm font-extrabold">Colour</h2>
          <div class="mt-3 flex flex-wrap gap-3">
            @each(color in product.colours)
              <button type="button" data-option-group="color" data-option-value="{{ color.name }}" class="flex items-center gap-2 rounded-lg border border-adonai-line bg-white px-3 py-2 text-xs font-bold text-adonai-muted"><span class="h-5 w-5 rounded-md border border-black/10" style="background: {{ color.hex }}"></span>{{ color.name }}</button>
            @endeach
          </div>
        </div>
      @endif

      <div class="mt-8 grid gap-2 rounded-lg border border-adonai-line bg-adonai-lavender p-4 text-sm text-adonai-ink"><p class="font-bold">Try and Confirm in Kampala</p><p class="text-xs leading-5 text-adonai-muted">Your rider brings the item to your delivery address. Check the fit and condition before you confirm payment.</p></div>
      <div class="mt-8"><button type="button" data-add-to-cart="{{ product.id }}" class="adonai-btn-primary w-full py-4 text-base">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8.5h14l-1 11H6l-1-11ZM9 8.5V6a3 3 0 0 1 6 0v2.5" /></svg>
        Add to bag
      </button></div>
    </div>
  </div>
</section>
