      <span class="rounded-full bg-adonai-lavender px-3 py-1 text-xs font-bold text-adonai-primary">{{ order.statusLabel }}</span>
    </div>

    @if(order.lines.length)
      <ul class="mt-5 divide-y divide-adonai-line">
        @each(line in order.lines)
          <li class="flex items-start justify-between gap-4 py-4">
            <div>
              <p class="font-bold">{{ line.name }}</p>
              <p class="mt-1 text-xs text-adonai-muted">{{ line.quantity }} × {{ line.priceLabel }}</p>
            </div>
            <p class="whitespace-nowrap font-bold">{{ line.lineTotalLabel }}</p>
          </li>
        @endeach
      </ul>
    @else
      <p class="mt-5 text-sm text-adonai-muted">
        The items on this order are not listed on the website any more, which usually means they have been
        sold. Call us and we will check the shelf for you.
      </p>
    @endif

    @if(order.totalLabel)
      <div class="mt-5 flex items-center justify-between border-t border-adonai-line pt-5">
        <p class="font-extrabold">Total</p>
        <p class="text-xl font-black">{{ order.totalLabel }}</p>
      </div>
    @endif

