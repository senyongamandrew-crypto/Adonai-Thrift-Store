      <p class="mt-4 text-sm text-adonai-muted">Payment: {{ order.paymentMethod }}</p>
    @endif
  </div>

  <div class="mt-8 rounded-3xl border border-adonai-line bg-adonai-canvas p-6">
    <h2 class="text-lg font-extrabold">What happens next</h2>
    <ol class="mt-4 space-y-3 text-sm leading-relaxed text-adonai-muted">
