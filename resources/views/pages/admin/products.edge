        Nothing listed yet. Add your first piece above and it will appear on the website straight away.
      </div>
    @endif

    @each(product in products)
      <div class="adonai-piece-row">
        @if(product.image)
          <img src="{{ product.image }}" alt="{{ product.name }}" class="h-20 w-20 rounded-lg border border-adonai-line object-cover" />
        @else
          <div class="grid h-20 w-20 shrink-0 place-items-center rounded-lg border border-adonai-line bg-adonai-canvas p-2 text-center text-[10px] font-bold leading-3 text-adonai-muted">No photo</div>
        @endif

        <div class="min-w-0">
          <p class="text-sm font-extrabold text-adonai-ink">{{ product.name }}</p>
          <p class="mt-1 text-xs leading-5 text-adonai-muted">
            {{ product.priceLabel }}
            @if(product.category)
              · {{ product.category }}
            @endif
            @if(product.size)
              · Size {{ product.size }}
            @endif
          </p>
          <span class="mt-2 inline-block rounded-full px-3 py-1 text-[11px] font-extrabold {{ product.available ? 'bg-adonai-sand text-adonai-primary' : 'bg-adonai-canvas text-adonai-muted' }}">
            {{ product.available ? 'Available' : 'Sold' }}
          </span>
        </div>

        {{-- Three taps, each at least 44px tall: the size a finger hits without aiming. --}}
        <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
          <a href="/shop/intake?edit={{ product.id }}" class="adonai-btn-secondary !px-3 text-xs">Edit</a>

          <form method="POST" action="/shop/intake/products/{{ product.id }}">
            @set('honeypotId', 'sold-' + product.id)
            @include('components/form_security')
            <input type="hidden" name="action" value="{{ product.available ? 'sold' : 'relist' }}" />
            <button type="submit" class="adonai-btn-secondary w-full !px-3 text-xs">{{ product.available ? 'Mark sold' : 'Relist' }}</button>
          </form>

          {{-- Deleting cannot be undone, so the app.js confirmation asks first.
               The button is brick red and separate from the two beside it. --}}
          <form method="POST" action="/shop/intake/products/{{ product.id }}" data-confirm="Delete {{ product.name }} from your catalogue? It disappears from the website. This cannot be undone." class="col-span-2 sm:col-span-1">
            @set('honeypotId', 'delete-' + product.id)
            @include('components/form_security')
            <input type="hidden" name="action" value="remove" />
            <button type="submit" class="adonai-btn-danger w-full text-xs">Delete</button>
          </form>
        </div>
      </div>
    @endeach
  </div>

  {{-- ---------------------------------------------------------------- backup --}}
  <div class="adonai-card p-5 sm:p-7">
    <h2 class="text-xl font-black tracking-tight text-adonai-ink">Backup and restore</h2>
    <p class="mt-1 text-sm leading-6 text-adonai-muted">
      Download a copy of your catalogue and keep it somewhere safe — on your phone, in Google Drive, or sent to yourself on WhatsApp. If anything ever happens to the website copy, paste the file back here and everything returns.
    </p>

    <a href="/shop/intake/backup" class="adonai-btn-primary mt-4 w-full py-4 text-base sm:w-auto sm:py-3 sm:text-sm">Download my catalogue</a>

    <form method="POST" action="/shop/intake/restore" class="mt-6 grid gap-3" data-confirm="Replace everything in your catalogue with this backup? Everything listed now is overwritten. This cannot be undone." novalidate>
      @set('honeypotId', 'restore-website')
      @include('components/form_security')
      <label class="grid gap-2 text-xs font-bold text-adonai-ink">
        Restore from a backup
        <textarea class="adonai-input min-h-24 font-mono text-[11px]" name="backup" placeholder="Paste the contents of your backup file here"></textarea>
      </label>
      <button type="submit" class="adonai-btn-danger w-full py-4 text-base sm:w-fit sm:py-3 sm:text-sm">Replace the catalogue with this backup</button>
    </form>
  </div>

