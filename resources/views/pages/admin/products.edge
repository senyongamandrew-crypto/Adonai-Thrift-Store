  {{-- ------------------------------------------------------------ add a piece --}}
  <div class="adonai-card p-5 sm:p-7">
    <h2 class="text-xl font-black tracking-tight text-adonai-ink">{{ editing ? 'Change this piece' : 'Add a piece' }}</h2>
    <p class="mt-1 text-sm leading-6 text-adonai-muted">
      @if(editing)
        Editing <span class="font-bold text-adonai-ink">{{ editing.name }}</span>. Leave a field empty to keep what is already saved.
      @else
        Only the name is required. A photo and a price sell the piece.
      @endif
    </p>

    {{-- A photo chosen here is stored by the same service the till uses, so it
         is served from /media/… exactly like a photo sent by the POS app. --}}
    <form method="POST" action="{{ editing ? '/shop/intake/products/' + editing.id : '/shop/intake/products' }}" enctype="multipart/form-data" class="mt-6 grid gap-7" novalidate>
      @set('honeypotId', 'piece-website')
      @include('components/form_security')

      {{-- ------------------------------------------------------- 1. the photo --}}
      <div class="grid gap-3">
        <p class="adonai-step-label"><span class="adonai-step-number">1</span>The photo</p>

        @if(editing && editing.image)
          <div class="flex items-center gap-4 rounded-lg border border-adonai-line bg-white p-3">
            <img src="{{ editing.image }}" alt="The photo customers see for {{ editing.name }}" class="adonai-photo-thumb !h-20 !w-20" />
            <p class="text-xs leading-5 text-adonai-muted">
              This is the photo customers see now. Keep it, or choose a new one below to replace it.
            </p>
          </div>
        @endif

        <input
          id="piece-photo"
          class="peer sr-only"
          type="file"
          name="photo"
          accept="image/*"
          data-photo-input
          data-photo-max-bytes="{{ photoLimitMb * 1024 * 1024 }}"
        />
        <label for="piece-photo" class="adonai-photo-picker peer-focus-visible:ring-2 peer-focus-visible:ring-adonai-primary/40">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-adonai-primary" aria-hidden="true">
            <path d="M4 8.5h3l1.5-2h7L17 8.5h3v10H4z" />
            <circle cx="12" cy="13" r="3.2" />
          </svg>
          <span class="text-sm font-extrabold text-adonai-ink">Take a photo, or choose one</span>
          <span class="text-xs leading-5 text-adonai-muted">Opens the camera on your phone. One photo, up to {{ photoLimitMb }} MB.</span>
        </label>

        {{-- Shown by app.js as soon as a photo is picked, so a photo that is too
             big is caught here instead of after the whole form is filled in. --}}
        <div class="adonai-photo-preview" data-photo-preview hidden>
          <img data-photo-preview-image alt="" class="adonai-photo-thumb !h-16 !w-16" />
          <div class="min-w-0 flex-1">
            <p data-photo-preview-name class="truncate text-xs font-bold text-adonai-ink"></p>
            <p data-photo-preview-note class="mt-1 text-xs leading-5 text-adonai-muted"></p>
          </div>
          <button type="button" data-photo-clear class="adonai-btn-secondary shrink-0 !px-3 !py-2 text-xs">Remove</button>
        </div>

        <details class="rounded-lg border border-adonai-line bg-adonai-canvas p-3">
          <summary class="cursor-pointer text-xs font-extrabold text-adonai-ink">Or paste a photo link instead</summary>
          <label class="mt-3 grid gap-2 text-xs font-bold text-adonai-ink">
            Photo link (https://...)
            <input class="adonai-input" name="image" type="url" value="{{ editing ? editing.image || '' : '' }}" placeholder="https://" />
          </label>
        </details>
      </div>

      {{-- --------------------------------------------------- 2. name and price --}}
      <div class="grid gap-4">
        <p class="adonai-step-label"><span class="adonai-step-number">2</span>What it is and what it costs</p>

        <label class="grid gap-2 text-xs font-bold text-adonai-ink">
          Item name
          <input class="adonai-input" name="name" type="text" autocomplete="off" value="{{ editing ? editing.name : '' }}" placeholder="Vintage denim jacket" />
        </label>

        <label class="grid gap-2 text-xs font-bold text-adonai-ink">
          Price in UGX
          <input class="adonai-input" name="price" type="text" inputmode="numeric" autocomplete="off" value="{{ editing && editing.price ? editing.price : '' }}" placeholder="45000" />
        </label>
      </div>

      {{-- ------------------------------------------------- 3. size and grade --}}
      <div class="grid gap-4">
        <p class="adonai-step-label"><span class="adonai-step-number">3</span>Size and condition</p>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-xs font-bold text-adonai-ink">
            Category
            <input class="adonai-input" name="category" type="text" autocomplete="off" value="{{ editing ? editing.category || '' : '' }}" placeholder="Outerwear" />
          </label>
          <label class="grid gap-2 text-xs font-bold text-adonai-ink">
            Size
            <input class="adonai-input" name="size" type="text" autocomplete="off" value="{{ editing ? editing.size || '' : '' }}" placeholder="M / 32" />
          </label>
        </div>

        <label class="grid gap-2 text-xs font-bold text-adonai-ink">
          Condition
          <input class="adonai-input" name="condition" type="text" autocomplete="off" value="{{ editing ? editing.condition || '' : '' }}" placeholder="Grade A, minor fade" />
        </label>
      </div>

      {{-- ---------------------------------------------------- 4. the write-up --}}
      <div class="grid gap-4">
        <p class="adonai-step-label"><span class="adonai-step-number">4</span>What you tell the customer</p>

        <label class="grid gap-2 text-xs font-bold text-adonai-ink">
          Description
          <textarea class="adonai-input min-h-28" name="description" placeholder="One-of-one piece, cleaned and measured in store.">{{ editing ? editing.description || '' : '' }}</textarea>
        </label>

        <label class="grid gap-2 text-xs font-bold text-adonai-ink">
          Measurements shown to customers
          <input class="adonai-input" name="measurementNote" type="text" autocomplete="off" value="{{ editing ? editing.measurementNote || '' : '' }}" placeholder="Chest 54cm, length 68cm" />
        </label>
      </div>

      {{-- ------------------------------------------- 5. the optional extras --}}
      <details class="rounded-lg border border-adonai-line bg-adonai-canvas p-4" {{ editing && ((editing.sizes && editing.sizes.length) || (editing.colours && editing.colours.length) || editing.newArrival) ? 'open' : '' }}>
        <summary class="cursor-pointer text-xs font-extrabold text-adonai-ink">More details — sizes, colours, and marking it as new</summary>

        <div class="mt-4 grid gap-4">
          <label class="grid gap-2 text-xs font-bold text-adonai-ink">
            Available sizes (comma separated)
            <input class="adonai-input" name="sizes" type="text" autocomplete="off" value="{{ editing && editing.sizes ? editing.sizes.join(', ') : '' }}" placeholder="S, M, L" />
          </label>
          <label class="grid gap-2 text-xs font-bold text-adonai-ink">
            Colours (comma separated)
            <input class="adonai-input" name="colours" type="text" autocomplete="off" value="{{ editing && editing.colours ? editing.colours.join(', ') : '' }}" placeholder="Indigo, Black" />
          </label>
          <label class="flex items-center gap-3 rounded-lg border border-adonai-line bg-white p-3 text-xs font-bold text-adonai-ink">
            <input type="checkbox" name="newArrival" value="true" {{ editing && editing.newArrival ? 'checked' : '' }} class="h-5 w-5" />
