          </label>
        </div>
      </details>

      {{-- ------------------------------------------------------------- submit --}}
      <div class="grid gap-3 border-t border-adonai-line pt-5 sm:flex sm:flex-wrap">
        <button type="submit" class="adonai-btn-primary w-full py-4 text-base sm:w-auto sm:py-3 sm:text-sm">{{ editing ? 'Save changes' : 'Add to the website' }}</button>
        @if(editing)
          <a href="/shop/intake" class="adonai-btn-secondary w-full sm:w-auto">Cancel</a>
        @endif
      </div>
    </form>
  </div>

  {{-- ------------------------------------------------------------ the pieces --}}
  <div class="grid gap-4">
    <h2 class="text-xl font-black tracking-tight text-adonai-ink">Your pieces ({{ products.length }})</h2>

    @if(!products.length)
