@layout('layouts/app')

@section('content')
{{--
  The home page is arranged the way a shop window is: the best piece first, then
  the promises, then the aisles, then the newest stock, then everything.

  Every section below is built only from what the shop itself entered in the POS.
  Nothing is invented: no countdown, no "only 3 left", no discount that the price
  does not actually show. When a section has nothing true to show, it is left out.
--}}

{{-- ============================================================ the hero --}}
<section class="adonai-hero">
  <div class="adonai-shell grid gap-10 py-12 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:py-20">
    <div>
      <p class="adonai-hero-badge">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5 14.6 9l6 .9-4.3 4.2 1 6-5.3-2.8L6.7 20l1-6L3.4 9.9l6-.9Z" /></svg>
        Every piece is one of a kind
      </p>

      <h1 class="mt-5 max-w-2xl text-4xl font-black leading-[1.03] tracking-[-.035em] text-white sm:text-6xl">
        {{ site.heroHeadline }}
      </h1>

      <p class="mt-6 max-w-xl text-base leading-7 text-adonai-sandStrong">
        Cleaned, measured and listed from our own stock in Kampala. Prices in UGX.
        When a piece is sold there is no second one — so if you like it, ask about it.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#collection" class="adonai-hero-button">
          Explore the collection
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
        <a href="{{ site.whatsappLink }}" class="adonai-hero-button-quiet">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 4.5h3l1.5 4-2 1.5a14 14 0 0 0 5 5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.5 1.5C11.37 19 5 12.63 5 4.5A1.5 1.5 0 0 1 6.5 3Z" /></svg>
          Ask about a piece
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md">
      <div class="aspect-[4/5] overflow-hidden rounded-lg border border-white/10 bg-adonai-night">
        @if(heroPiece && heroPiece.image)
          <picture class="block h-full w-full">
            @if(heroPiece.imageAvif)
              <source srcset="{{ heroPiece.imageAvif }}" type="image/avif" />
            @endif
            @if(heroPiece.imageWebp)
              <source srcset="{{ heroPiece.imageWebp }}" type="image/webp" />
            @endif
            <img src="{{ heroPiece.image }}" alt="{{ heroPiece.name || 'Adonai Thrift Store piece' }}" class="h-full w-full object-cover" loading="eager" decoding="async" />
          </picture>
        @else
          <div class="adonai-photo-skeleton" role="img" aria-label="A photo of the newest piece will appear here">
            <span class="h-3 w-2/5 rounded-sm bg-adonai-skeletonDark"></span>
            <span class="h-3 w-3/5 rounded-sm bg-adonai-skeletonDark"></span>
            <span class="h-3 w-1/3 rounded-sm bg-adonai-skeletonDark"></span>
          </div>
        @endif
      </div>
      @if(heroPiece && heroPiece.image)
        <p class="mt-3 text-xs leading-5 text-adonai-sandStrong/80">
          Just in: <a href="/products/{{ heroPiece.id }}" class="font-bold text-white underline underline-offset-2">{{ heroPiece.name }}</a> — {{ heroPiece.priceFormatted }}
        </p>
      @endif
    </div>
  </div>
</section>

