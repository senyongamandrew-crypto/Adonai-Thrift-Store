{{-- ================================================== the whole collection --}}
<section class="adonai-shell pb-12 sm:pb-16" id="collection">
  <div class="flex flex-col justify-between gap-4 border-b border-adonai-line pb-6 sm:flex-row sm:items-end">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[.18em] text-adonai-primary">Everything in the shop</p>
      <h2 class="mt-2 text-3xl font-black tracking-tight text-adonai-ink sm:text-4xl">
        @if(activeCategory)
          {{ activeCategory }}
        @elseif(searchQuery)
          Results for "{{ searchQuery }}"
        @else
          All available pieces
        @endif
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-adonai-muted">
        @if(filteredByCategory)
          {{ products.length }} {{ products.length === 1 ? 'piece matches' : 'pieces match' }}.
          <a class="font-bold text-adonai-primary underline underline-offset-2" href="/#collection">Show everything</a>
        @else
          Availability changes the moment a piece is sold in the store, so the list is always today's stock.
        @endif
      </p>
    </div>
    <span class="shrink-0 text-xs font-bold text-adonai-muted">Serving Kampala</span>
  </div>

  {{-- Category filters: real links, so they work with or without JavaScript. --}}
  <div class="mt-6 flex gap-2 overflow-x-auto pb-2">
    <a class="adonai-filter {{ !activeCategory ? 'adonai-filter-active' : '' }} whitespace-nowrap" href="/#collection">All pieces</a>
    @each(category in categories)
      <a class="adonai-filter {{ activeCategory === category ? 'adonai-filter-active' : '' }} whitespace-nowrap" href="/?category={{ category }}#collection">{{ category }}</a>
    @endeach
  </div>

  {{--
    The search box filters the pieces already on the page. This line is where the
    result of that filtering is reported, and it is a live region so a customer
    using a screen reader hears the count instead of being left guessing. It stays
    empty until a search is typed.
  --}}
  <p class="mt-4 min-h-5 text-xs font-bold text-adonai-muted" data-search-status role="status" aria-live="polite"></p>

  @if(catalogState === 'not_configured')
    <div class="adonai-card mt-8 grid min-h-64 place-items-center p-8 text-center">
      <div>
        <p class="text-sm font-extrabold text-adonai-primary">Our online catalog is being connected</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-adonai-muted">Pieces are listed on the Adonai POS and will appear here shortly. In the meantime, message or call the store and we will tell you exactly what is available today.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="{{ site.whatsappLink }}" class="adonai-btn-primary !rounded-md !px-4 !py-2.5 text-xs">WhatsApp us on {{ site.whatsappNumber }}</a>
          <a href="{{ site.callLink }}" class="adonai-btn-secondary !rounded-md !px-4 !py-2.5 text-xs">Call {{ site.callNumber }}</a>
        </div>
      </div>
    </div>
  @elseif(catalogState === 'unavailable')
    <div class="adonai-card mt-8 grid min-h-64 place-items-center p-8 text-center">
      <div>
        <p class="text-sm font-extrabold text-adonai-primary">The catalog is momentarily unavailable</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-adonai-muted">Our store inventory service is not responding, so we are not showing an incomplete list. Please try again shortly, or contact the store for current stock.</p>
        <a href="{{ site.whatsappLink }}" class="adonai-btn-secondary mt-5 !rounded-md !px-4 !py-2.5 text-xs">Ask about stock on WhatsApp</a>
      </div>
    </div>
  @elseif(products && products.length)
    <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4" data-product-grid>
      @each(product in products)
        @include('components/product_card')
      @endeach
    </div>
    <div class="adonai-card mt-8 hidden p-8 text-center" data-search-empty>
      <p class="text-sm font-extrabold text-adonai-primary">No matching item</p>
      <h3 class="mt-2 text-2xl font-black text-adonai-ink">Try another search</h3>
      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-adonai-muted">Search by item name, category, size or condition, or contact the store for help.</p>
    </div>
  @elseif(filteredByCategory)
    <div class="adonai-card mt-8 grid min-h-56 place-items-center p-8 text-center">
      <div>
        <p class="text-sm font-extrabold text-adonai-primary">Nothing listed here right now</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-adonai-muted">
          @if(activeCategory)
            We have no {{ activeCategory }} in stock today.
          @else
            Nothing matches that search today.
          @endif
          Stock changes often — ask us and we will tell you what has just arrived.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="/#collection" class="adonai-btn-secondary !rounded-md !px-4 !py-2.5 text-xs">See everything</a>
          <a href="{{ site.whatsappLink }}" class="adonai-btn-primary !rounded-md !px-4 !py-2.5 text-xs">Ask about stock</a>
        </div>
      </div>
    </div>
  @else
    <div class="adonai-card mt-8 grid min-h-64 place-items-center p-8 text-center">
      <div>
        <p class="text-sm font-extrabold text-adonai-primary">No available pieces are listed right now</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-adonai-muted">Check again after the next inventory update or ask the store about current stock on WhatsApp.</p>
        <a href="{{ site.whatsappLink }}" class="adonai-btn-secondary mt-5 !rounded-md !px-4 !py-2.5 text-xs">Ask about stock</a>
      </div>
    </div>
  @endif
</section>

{{-- ================================================= how the shop works --}}
<section id="about" class="border-t border-adonai-line bg-adonai-sand">
  <div class="adonai-shell grid gap-8 py-12 md:grid-cols-2 md:items-center md:py-16">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[.18em] text-adonai-primary">How Adonai works</p>
