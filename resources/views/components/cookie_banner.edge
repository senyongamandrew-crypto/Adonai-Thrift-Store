<aside class="adonai-cookie-banner" data-cookie-banner role="region" aria-label="Cookie notice" hidden>
  <div>
    <p class="text-sm font-extrabold text-adonai-ink">Cookie settings</p>
    <p class="mt-1 max-w-2xl text-xs leading-5 text-adonai-muted">Essential storage keeps your bag, account session and cookie preference. Optional analytics loads only when configured.</p>
  </div>
  <button type="button" class="adonai-btn-primary shrink-0 !rounded-md !px-4 !py-2.5 text-xs" data-cookie-accept>Accept</button>
</aside>
