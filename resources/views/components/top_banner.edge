@if (site.promoBanner)
  {{--
    Promo strip. Hidden until PROMO_BANNER is given a value in the hosting
    dashboard, so the storefront looks exactly the same by default.
  --}}
  <section class="bg-adonai-primary text-white" aria-label="Store announcement">
    <div class="adonai-shell flex min-h-11 flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2 text-center text-[11px] font-semibold leading-4 sm:text-xs">
      <span>{{ site.promoBanner }}</span>
    </div>
  </section>
@endif
<section class="adonai-top-banner" aria-label="Adonai Store contact notice">
  <div class="adonai-shell flex min-h-11 flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2 text-center text-[11px] font-semibold leading-4 sm:text-xs">
    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-adonai-primary" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 4.5h3l1.5 4-2 1.5a14 14 0 0 0 5 5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.5 1.5C11.37 19 5 12.63 5 4.5A1.5 1.5 0 0 1 6.5 3Z" /></svg>
    <span>{{ site.bannerText }} Call <a class="font-extrabold text-white underline decoration-adonai-primary underline-offset-2" href="{{ site.callLink }}">{{ site.callNumber }}</a> or WhatsApp <a class="font-extrabold text-white underline decoration-adonai-primary underline-offset-2" href="{{ site.whatsappLink }}">{{ site.whatsappNumber }}</a>.</span>
    <span class="hidden text-adonai-sandStrong sm:inline">{{ site.deliveryNote }}</span>
  </div>
</section>
