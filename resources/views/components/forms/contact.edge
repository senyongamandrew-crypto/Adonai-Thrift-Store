          <input class="adonai-input" name="name" type="text" autocomplete="name" required placeholder="Your name" />
        </label>
        <label class="grid gap-2 text-xs font-bold text-adonai-ink">Phone
          <input class="adonai-input" name="phone" type="tel" autocomplete="tel" required placeholder="{{ site.whatsappDisplay }}" />
