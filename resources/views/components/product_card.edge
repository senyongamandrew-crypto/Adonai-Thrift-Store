{{--
  One piece in a grid.

  A thrift item is a single object, so the card leads with its photo, says
  "one of a kind" when the shop marked it as new, and keeps the two useful
  actions within thumb reach: open the piece, or put it in the bag.

  data-product-card / data-product-search are what the search box filters on —
  the words in the last attribute are the ones a customer can type.
--}}
<article class="group flex flex-col overflow-hidden rounded-lg border border-adonai-line bg-white shadow-card transition-transform duration-200 hover:-translate-y-0.5" data-product-card="{{ product.id }}" data-product-search="{{ [product.name, product.category, product.size, product.condition, product.description].filter(Boolean).join(' ') }}">
  <div class="relative aspect-[4/5] overflow-hidden bg-adonai-skeleton">
    @if(product.image)
      <a href="/products/{{ product.id }}" class="block h-full w-full" aria-label="View {{ product.name }}">
        <picture class="block h-full w-full">
          @if(product.imageAvif)
            <source srcset="{{ product.imageAvif }}" type="image/avif" />
          @endif
          @if(product.imageWebp)
            <source srcset="{{ product.imageWebp }}" type="image/webp" />
          @endif
          <img src="{{ product.image }}" alt="{{ product.name || 'Adonai Thrift Store piece' }}" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" decoding="async" />
        </picture>
      </a>
    @else
      <a href="/products/{{ product.id }}" class="block h-full w-full" aria-label="View {{ product.name }}">
        <div class="adonai-photo-skeleton" role="img" aria-label="No photo for this piece yet">
          <span class="h-3 w-2/5 rounded-sm bg-adonai-skeletonDark"></span>
          <span class="h-3 w-3/5 rounded-sm bg-adonai-skeletonDark"></span>
          <span class="h-3 w-1/3 rounded-sm bg-adonai-skeletonDark"></span>
        </div>
      </a>
    @endif

    @if(product.newArrival)
      <span class="adonai-tag absolute left-3 top-3">New</span>
    @endif
  </div>

  <div class="flex flex-1 flex-col gap-3 p-3.5">
    <div class="min-w-0 flex-1">
      <p class="truncate text-[10px] font-extrabold uppercase tracking-[.14em] text-adonai-primary">{{ product.category }}</p>
      <h3 class="mt-1 text-sm font-bold leading-snug text-adonai-ink">
        <a href="/products/{{ product.id }}" class="transition-colors hover:text-adonai-primary">{{ product.name }}</a>
      </h3>
      @if(product.size || product.condition)
        <p class="mt-1.5 truncate text-xs text-adonai-muted">
          @if(product.size)
            Size {{ product.size }}
          @endif
          @if(product.size && product.condition)
            ·
          @endif
          @if(product.condition)
            {{ product.condition }}
          @endif
        </p>
      @endif
    </div>

    <div class="flex items-end justify-between gap-3">
      <div class="min-w-0">
        <p class="text-base font-black text-adonai-ink">{{ product.priceFormatted }}</p>
        @if(product.originalPriceFormatted)
          <p class="text-xs text-adonai-muted line-through">{{ product.originalPriceFormatted }}</p>
        @endif
      </div>
      <button type="button" class="adonai-icon-button" data-add-to-cart="{{ product.id }}" aria-label="Put {{ product.name }} in the bag">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8.5h14l-1 11H6l-1-11ZM9 8.5V6a3 3 0 0 1 6 0v2.5" /></svg>
      </button>
    </div>

    <a href="/products/{{ product.id }}" class="text-xs font-bold text-adonai-primary underline underline-offset-4">View this piece</a>
  </div>
</article>
