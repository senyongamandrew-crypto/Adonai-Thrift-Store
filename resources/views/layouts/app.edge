    @include('components/top_banner')

    {{--
      The header scrolls away with the page rather than following the customer
      down it. On a phone it carries the logo, the buttons and the search box,
      which is a lot of a small screen; pinning it there would leave less room
      for the clothes, which is what people came to look at. The search box is
      still one short scroll up, and the bag is linked again in the footer.
    --}}
    <header class="border-b border-adonai-line bg-adonai-canvas">
      <div class="adonai-shell flex min-h-20 items-center justify-between gap-4 py-3 sm:min-h-24 sm:py-4">
        <a href="/" class="flex shrink-0 items-center" aria-label="Adonai Thrift Store home">
          <img src="/assets/primary-logo-light.png" alt="Adonai Thrift Store logo" class="h-16 w-auto object-contain mix-blend-multiply sm:h-20" />
        </a>

          <nav class="hidden items-center gap-5 text-sm font-semibold text-adonai-muted lg:flex" aria-label="Main navigation">
            <a class="transition-colors hover:text-adonai-primary" href="/#collection">Shop all</a>
            @each(navCategory in categories)
              <a class="transition-colors hover:text-adonai-primary" href="/?category={{ navCategory }}#collection">{{ navCategory }}</a>
            @endeach
            <a class="transition-colors hover:text-adonai-primary" href="/#about">About Adonai</a>
          </nav>

          <div class="flex items-center gap-2">
            <a href="/account/sign-in" class="grid h-10 w-10 place-items-center rounded-md border border-adonai-line bg-white text-adonai-ink transition-colors hover:border-adonai-primary hover:text-adonai-primary" aria-label="Customer account">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M18 20a6 6 0 0 0-12 0M12 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
            </a>
            <a href="/#collection" class="hidden rounded-md bg-adonai-primary px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-adonai-primaryDark md:inline-flex">Shop now</a>
            <a href="/checkout" class="adonai-btn-primary !rounded-md !px-4 !py-2.5" aria-label="Shopping bag">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8.5h14l-1 11H6l-1-11ZM9 8.5V6a3 3 0 0 1 6 0v2.5" /></svg>
              <span>Bag</span><span id="adonai-bag-count" class="grid min-w-5 place-items-center rounded-md bg-white/20 px-1.5">{{ bagCount || 0 }}</span>
            </a>
          </div>
      </div>
