#
# Test-only environment. Safe to commit: every value here is a dummy used by
# "npm test" locally and in CI. Never reuse APP_KEY outside of tests.
#
TZ=UTC
NODE_ENV=test
HOST=127.0.0.1
PORT=3334
LOG_LEVEL=error

APP_NAME="Adonai Thrift Store"
APP_KEY=k4c2Zb7uJx0qP3mY5tR8wE1nB6vC9dF2gH4jK7lM0nQ=
# Left empty on purpose: the tests cover the auto-detected URL behaviour.
APP_URL=
SITE_URL=

SESSION_DRIVER=cookie
FORCE_HTTPS=false

# The tests must pass without a live POS backend, so this points at a closed
# port on purpose.
FLASK_API_BASE_URL=http://127.0.0.1:9
FLASK_INTERNAL_API_TOKEN=

DB_CONNECTION=sqlite
DATABASE_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
# Kept apart from a real run's photos, like the test catalogue.
ADONAI_MEDIA_DIR=storage/test-media
ADONAI_MEDIA_MAX_FILE_BYTES=26214400
ADONAI_MEDIA_QUOTA_BYTES=0

ANALYTICS_PROVIDER=none
ANALYTICS_DOMAIN=
GA4_MEASUREMENT_ID=

# Keep test catalogues out of the real one: each run starts from this folder.
ADONAI_DATA_DIR=storage/test-data
