<article class="overflow-hidden rounded-lg border border-adonai-line bg-white shadow-card" data-product-card="{{ product.id }}" data-product-search="{{ product.name }} {{ product.category }} {{ product.brand }} {{ product.size }} {{ product.condition }}">
  <div class="relative aspect-[4/5] overflow-hidden bg-adonai-skeleton">
    @if(product.image)
      <a href="/products/{{ product.id }}" class="block h-full w-full" aria-label="View {{ product.name }}">
        <picture class="block h-full w-full">
          @if(product.imageAvif)
            <source srcset="{{ product.imageAvif }}" type="image/avif" />
          @endif
          @if(product.imageWebp)
            <source srcset="{{ product.imageWebp }}" type="image/webp" />
          @endif
          <img src="{{ product.image }}" alt="{{ product.name || 'Adonai Thrift Store product' }}" class="h-full w-full object-cover" loading="lazy" decoding="async" />
        </picture>
      </a>
    @else
      <div class="adonai-photo-skeleton" role="img" aria-label="Product image not available">
        <span class="h-3 w-2/5 rounded-sm bg-adonai-skeletonDark"></span>
        <span class="h-3 w-3/5 rounded-sm bg-adonai-skeletonDark"></span>
        <span class="h-3 w-1/3 rounded-sm bg-adonai-skeletonDark"></span>
      </div>
    @endif
  </div>

  <div class="grid gap-4 p-4">
    <div class="min-w-0">
      <p class="truncate text-[10px] font-extrabold uppercase tracking-[.14em] text-adonai-primary">{{ product.category }}</p>
      <h3 class="mt-1 truncate text-sm font-bold text-adonai-ink"><a href="/products/{{ product.id }}" class="transition-colors hover:text-adonai-primary">{{ product.name }}</a></h3>
      @if(product.condition)
        <p class="mt-2 text-xs text-adonai-muted">Condition: {{ product.condition }}</p>
      @endif
    </div>
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="text-base font-extrabold text-adonai-ink">{{ product.priceFormatted }}</p>
        @if(product.originalPriceFormatted)
          <p class="text-xs text-adonai-muted line-through">{{ product.originalPriceFormatted }}</p>
        @endif
      </div>
      <span class="text-xs font-semibold text-adonai-muted">{{ product.size || 'Size on request' }}</span>
    </div>
    <div class="grid gap-2 sm:grid-cols-2">
      <a href="/products/{{ product.id }}" class="adonai-btn-secondary !rounded-md !px-3 !py-2 text-xs">View item</a>
      <button type="button" data-add-to-cart="{{ product.id }}" class="adonai-btn-primary !rounded-md !px-3 !py-2 text-xs">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8.5h14l-1 11H6l-1-11ZM9 8.5V6a3 3 0 0 1 6 0v2.5" /></svg>
        Add to bag
      </button>
    </div>
  </div>
</article>
